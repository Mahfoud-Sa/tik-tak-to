{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XO Game Version History Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "releases"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "latest_stable": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "tag_name",
          "channel",
          "published_at",
          "release_notes",
          "release_page_url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "tag_name": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": ["stable", "prerelease", "beta", "alpha"]
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "mandatory": {
            "type": "boolean"
          },
          "min_supported_version": {
            "type": "string"
          },
          "release_notes": {
            "type": "string"
          },
          "release_page_url": {
            "type": "string",
            "format": "uri"
          },
          "platforms": {
            "type": "object"
          }
        }
      }
    }
  }
}
